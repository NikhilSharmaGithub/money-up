<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+ asks before an app may notify at all, and a permission
         that is not declared is refused instantly without drawing anything —
         which would burn the one prompt a player ever gets. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.MoneyMove">

        <!-- Google Mobile Ads reads this from its own content provider before
             the app's first line runs, and a missing or malformed value is an
             exception thrown there — a crash at launch nothing can catch. The
             placeholder is filled by app/build.gradle.kts, which only ever
             puts a well-formed id in it: the owner's ADMOB_APP_ID, or Google's
             sample id when there is none yet. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- The SDK's start-up and its ad loading moved off the main thread.
             Current SDKs default both to true; they are said out loud here so
             an SDK that changes its mind cannot quietly put that work back on
             the thread that draws the board. -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true"
            tools:replace="android:value" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true"
            tools:replace="android:value" />
        <!-- Nothing is measured at launch. The SDK otherwise starts sending
             its own app-measurement events the moment the process starts;
             with this it waits until the app starts the SDK or loads an ad,
             and this app does neither until somebody taps an offer or a
             pre-game break is due. -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <!-- What a push from the server looks like when the app is not on
             screen and Android draws it without asking the app. The server
             names the channel in every push; these are the rest, and the
             channel for one that names none. "turns" because a turn is what
             push is for, the die because it is the app's own face, and gold
             because that is the accent all three clients share. The three
             channels themselves are made at launch (PushChannels). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="turns" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_turn" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/gold" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MoneyMove.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Invite links open the table straight in the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.moneymove.live" />
                <data android:scheme="https" android:host="moneymove.live" />
                <!-- Links sent before the custom domain still open in the app. -->
                <data android:scheme="https" android:host="money-up-nine.vercel.app" />
                <!-- A room link carries its code in the query, which an intent
                     filter cannot match on, so the path is what is matched and
                     MainActivity reads the code off the data URI. -->
                <data android:pathPattern="/.*" />
            </intent-filter>
        </activity>

        <!-- The cup's reminders: the fifteen-minute warning, the door
             opening and the last call, set by the app itself for as long as
             the server cannot push to this phone — they stand down the moment
             it says it can. Nothing outside the app has any business sending
             it one. See CupReminders. -->
        <receiver
            android:name=".CupReminderReceiver"
            android:exported="false" />

        <!-- Where FCM hands a push that arrives while the app is on screen,
             and a rotated token. Not exported: Google Play services reaches
             it through firebase-messaging's own receiver, which is. Declared
             in every build — without google-services.json there is no token,
             so nothing is ever delivered to it. -->
        <service
            android:name=".MoneyMoveMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
